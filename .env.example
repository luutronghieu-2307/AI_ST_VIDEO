PIXAZO_API_KEY=YOUR_SUBSCRIPTION_KEY
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_CREATIVE_MODEL=openai/gpt-oss-120b

# ── GitHub License Key Store ─────────────────────────────────────────────
# Fine-grained PAT chỉ cần quyền "Contents: Read and write" trên 1 repo duy nhất
GITHUB_TOKEN=github_pat_YOUR_FINE_GRAINED_TOKEN
GITHUB_REPO=your-username/aura-license-keys
GITHUB_KEYS_PATH=keys.json
GITHUB_API_TIMEOUT=15
