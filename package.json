{
  "name": "aura-ai-logo-tests",
  "version": "1.0.0",
  "description": "Jest tests cho AURA AI Logo Generator frontend JS",
  "scripts": {
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --coverageThreshold='{\"global\":{\"lines\":90,\"functions\":90,\"branches\":80,\"statements\":90}}'"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testMatch": [
      "**/test/test_*.js"
    ],
    "collectCoverageFrom": [
      "templates/js/*.js"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "coverageDirectory": "test/coverage-js"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  }
}
